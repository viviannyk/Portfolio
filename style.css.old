/* RESET E ESTILOS GERAIS */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Arial', sans-serif;
}

body {
    background-color: #1a1a2e;
    color: #fff;
    line-height: 1.6;
    overflow-x: hidden;
}

/* HEADER E NAVEGAÇÃO */
header {
    padding: 20px;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    transition: all 0.3s ease;
}

nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

nav ul {
    list-style: none;
    display: flex;
    justify-content: center;
    flex: 1;
}

nav ul li {
    margin: 0 15px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s;
}

nav ul li a:hover {
    color: #D46AFF;
}

.social-icons a {
    color: #fff;
    margin: 0 10px;
    font-size: 20px;
    transition: color 0.3s;
}

.social-icons a:hover {
    color: #D46AFF;
}

/* HERO SECTION - CENTRALIZAÇÃO DA FOTO */
.hero {
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center; /* Centraliza horizontalmente */
    justify-content: center; /* Centraliza verticalmente */
    text-align: center;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    position: relative;
}

/* Camada escura para dar contraste ao fundo */
.hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(26, 26, 46, 0.6); 
    z-index: 1;
}

.hero .container {
    position: relative;
    z-index: 2; /* Garante que o conteúdo fique acima do fundo */
}

.profile-container {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
}

.profile-img {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid #D46AFF;
    box-shadow: 0 0 20px rgba(212, 106, 255, 0.4);
}

.hero h1 {
    font-size: 3rem;
    margin-bottom: 10px;
}

.hero p {
    font-size: 1.2rem;
    color: #ddd;
}

/* ABOUT ME SECTION */
.about-me {
    padding: 100px 0;
    background-color: #1a1a2e;
}

.about-content {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    flex-wrap: wrap;
    gap: 50px;
}

.about-img {
    width: 350px;
    height: 450px;
    object-fit: cover;
    border-radius: 15px;
    box-shadow: 10px 10px 0px #D46AFF;
}

.about-text {
    max-width: 600px;
    flex: 1;
}

.about-text h2 {
    font-size: 1.2rem;
    color: #D46AFF;
    text-transform: uppercase;
    letter-spacing: 2px;
}

.about-text h3 {
    font-size: 2.5rem;
    margin: 10px 0 20px;
}

.about-text h3::after {
    content: "";
    display: block;
    width: 60px;
    height: 3px;
    background-color: #D46AFF;
    margin-top: 10px;
}

.info-box {
    border: 1px solid rgba(212, 106, 255, 0.3);
    padding: 25px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    margin: 30px 0;
}

.info-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr; /* Divide as infos em duas colunas */
    gap: 15px;
}

.info-list li strong {
    color: #D46AFF;
}

/* BOTÃO DOWNLOAD */
.btn-download {
    display: inline-block;
    padding: 12px 30px;
    background-color: #D46AFF;
    color: #fff;
    text-decoration: none;
    border-radius: 50px;
    font-weight: bold;
    transition: transform 0.3s, background-color 0.3s;
}

.btn-download:hover {
    background-color: #bf40ff;
    transform: translateY(-3px);
}

/* FOOTER */
footer {
    text-align: center;
    padding: 40px;
    background-color: #111;
    border-top: 1px solid #222;
}

footer p {
    color: #777;
    font-size: 0.9rem;
}

/* RESPONSIVIDADE */
@media (max-width: 768px) {
    .about-content {
        flex-direction: column;
        text-align: center;
    }

    .about-text h3::after {
        margin: 10px auto;
    }

    .info-list {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 2rem;
    }

    nav ul {
        display: none; /* Idealmente você teria um menu mobile aqui */
    }
}
